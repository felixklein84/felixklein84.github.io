---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="Work · Felix Klein"
  description="Projects by Felix Klein: embedded acoustic perception, multi-robot planning for autonomous tractors, stochastic cancer modelling, structural design, teaching and web systems."
>
  <header class="page-head">
    <h1>Work</h1>
    <p class="lead">
      Research, hardware, industry and one family business. Each write-up starts with the problem, because that is
      where the interesting decisions were made.
    </p>
  </header>

  <ul class="index">
    {
      projects.map((p) => (
        <li>
          <a href={`/projects/${p.slug}`}>
            <span class="rows-year">{p.year}</span>
            <div>
              <h2>{p.title}</h2>
              <p>{p.summary}</p>
            </div>
            <span class="rows-domain">{p.domain}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
