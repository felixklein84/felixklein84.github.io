---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredProjects } from '../data/projects';
import { profile } from '../data/cv';
---

<BaseLayout>
  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Mathematics · AI · Robotics · Real-world systems</p>
      <h1>Building clean models for messy systems.</h1>
      <p class="hero-lead">
        I work at the intersection of mathematical modelling, scientific computing, autonomous
        systems, supply-chain analytics and digital business. My projects range from glioblastoma
        simulations and multi-agent field operations to practical systems for a family winery.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/projects">View Projects</a>
        <a class="button ghost" href="/cv/Felix_Klein_CV.pdf" target="_blank" download>Download CV</a>
        <a class="button ghost icon-btn" href={profile.github} target="_blank" rel="noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <a class="button ghost icon-btn" href={profile.linkedin} target="_blank" rel="noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
    <aside class="hero-photo-panel" aria-label="Profile photo">
      <div class="hero-photo-wrap">
        <img src="/images/felix.jpg" alt="Felix Klein" class="hero-photo" />
      </div>
      <div class="hero-meta-cards">
        <div class="meta-chip">
          <span class="meta-chip-label">Based in</span>
          <strong>Munich, Germany</strong>
        </div>
        <div class="meta-chip">
          <span class="meta-chip-label">Background</span>
          <strong>Business Mathematics, Uni Mannheim</strong>
        </div>
        <div class="meta-chip accent">
          <span class="meta-chip-label">Focus</span>
          <strong>Mathematical modelling · AI · Robotics</strong>
        </div>
      </div>
    </aside>
  </section>

  <!-- ── ABOUT ──────────────────────────────────────────────────────────── -->
  <section class="section about-section" id="about">
    <div class="about-grid">
      <div class="about-text">
        <p class="eyebrow">About</p>
        <h2>Not just another data profile.</h2>
        <p>
          My background in Business Mathematics at the University of Mannheim gave me a solid grounding
          in stochastic processes, numerical analysis, optimisation and programming. My bachelor thesis
          modelled glioblastoma cell-population dynamics using continuous-time Markov chains — a project
          that crystallised my interest in applying rigorous mathematical structure to complex, real-world
          systems.
        </p>
        <p>
          Since then I have worked across aerospace supply chains at Deutsche Aircraft, data science
          consulting at KPMG, logistics at BMW, and built the full digital infrastructure for a family
          winery. An exchange semester at the University of Sydney broadened my perspective across
          applied mathematics and business.
        </p>
        <p>
          The thread connecting everything: understand a complex system, reduce it to the right structure,
          and build something that actually works. My current interests point toward robotics, biomedical
          engineering and computational engineering at master's level.
        </p>
      </div>
      <div class="about-signals">
        <div class="signal-card">
          <span>Scientific computing</span>
          <strong>Stochastic processes, Markov chains, simulation, numerical analysis</strong>
        </div>
        <div class="signal-card">
          <span>Autonomous systems</span>
          <strong>Multi-agent scheduling, robotics, field operations, GIS</strong>
        </div>
        <div class="signal-card">
          <span>Applied analytics</span>
          <strong>Supply-chain data quality, SAP, Power BI, process automation</strong>
        </div>
        <div class="signal-card accent">
          <span>Digital business</span>
          <strong>E-commerce, UX, SEO, product data — for a real family winery</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROJECTS ───────────────────────────────────────────────────────── -->
  <section class="section" id="projects">
    <SectionHeading
      eyebrow="Selected work"
      title="Projects that show the range"
      text="A focused selection: research, robotics, education, supply chain and a real family business."
    />
    <div class="project-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="section-cta">
      <a class="button primary" href="/projects">All projects</a>
    </div>
  </section>

  <!-- ── EDUCATION ─────────────────────────────────────────────────────── -->
  <section class="section" id="education">
    <SectionHeading
      eyebrow="Education"
      title="Academic foundation"
      text="Grounded in mathematics and shaped by international exposure."
    />
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-year">2019–2024</div>
        <div class="timeline-body">
          <h3>B.Sc. Business Mathematics</h3>
          <p class="timeline-place">University of Mannheim, Germany</p>
          <p>
            Core: stochastic processes, numerical analysis, optimisation, statistics, programming.
            Bachelor thesis: <em>Glioblastoma cell-population dynamics modelled with continuous-time Markov chains</em> — mathematical modelling of cancer cell states and therapy effects.
          </p>
          <div class="tag-row spacious">
            <span>Stochastic Processes</span><span>Numerical Analysis</span><span>Optimisation</span><span>Statistics</span><span>Python</span>
          </div>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-year">Semester abroad</div>
        <div class="timeline-body">
          <h3>Exchange Semester</h3>
          <p class="timeline-place">University of Sydney, Australia</p>
          <p>
            Applied mathematics and international business perspective. Broadened exposure to computational methods and diverse academic environments.
          </p>
        </div>
      </div>
      <div class="timeline-item future">
        <div class="timeline-year">Target</div>
        <div class="timeline-body">
          <h3>M.Sc. — Robotics / Biomedical Engineering / Applied Physics</h3>
          <p class="timeline-place">TUM · ETH Zürich · or similar</p>
          <p>
            Current focus: deepening capabilities in control systems, autonomous systems, computational physics and biomedical modelling. Target programmes at TUM and ETH Zürich.
          </p>
          <div class="tag-row spacious">
            <span>Robotics</span><span>Biomedical Engineering</span><span>Applied Physics</span><span>AI / ML</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── EXPERIENCE ────────────────────────────────────────────────────── -->
  <section class="section" id="experience">
    <SectionHeading
      eyebrow="Experience"
      title="Where the work happened"
      text="Across aerospace, consulting, automotive and a family business."
    />
    <div class="exp-grid">
      <div class="exp-card">
        <div class="exp-header">
          <span class="exp-year">2024–2025</span>
          <span class="exp-tag">Full-time</span>
        </div>
        <h3>Deutsche Aircraft</h3>
        <p class="exp-role">Supply Chain Operations & Automation</p>
        <p>
          Built supplier delivery-date visibility tools using SAP data exports, Power BI dashboards
          and Python automation scripts. Improved data quality monitoring across procurement and logistics.
        </p>
        <div class="tag-row spacious">
          <span>SAP</span><span>Power BI</span><span>Python</span><span>Supply Chain</span>
        </div>
      </div>

      <div class="exp-card">
        <div class="exp-header">
          <span class="exp-year">2023</span>
          <span class="exp-tag">Internship</span>
        </div>
        <h3>KPMG</h3>
        <p class="exp-role">Data Science Consulting Intern</p>
        <p>
          Supported analytics and AI-related workstreams in consulting engagements. Worked on
          forecasting, data processing and internal tooling projects.
        </p>
        <div class="tag-row spacious">
          <span>Data Science</span><span>Analytics</span><span>Consulting</span><span>Python</span>
        </div>
      </div>

      <div class="exp-card">
        <div class="exp-header">
          <span class="exp-year">2022</span>
          <span class="exp-tag">Internship</span>
        </div>
        <h3>BMW</h3>
        <p class="exp-role">Logistics Intern</p>
        <p>
          Gained operational exposure to automotive supply-chain processes, logistics workflows
          and production planning within a large-scale manufacturing environment.
        </p>
        <div class="tag-row spacious">
          <span>Logistics</span><span>Supply Chain</span><span>Automotive</span>
        </div>
      </div>

      <div class="exp-card accent">
        <div class="exp-header">
          <span class="exp-year">2020–present</span>
          <span class="exp-tag">Ongoing</span>
        </div>
        <h3>Weingut Martin Klein</h3>
        <p class="exp-role">Digitalization, E-Commerce & SEO</p>
        <p>
          Full digital build for a family winery: WooCommerce shop, product data architecture,
          SEO strategy, Google Business presence, product photography, UX and B2B sales material.
        </p>
        <div class="tag-row spacious">
          <span>WordPress</span><span>WooCommerce</span><span>SEO</span><span>UX</span><span>Product Data</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONTACT ───────────────────────────────────────────────────────── -->
  <section class="section contact-section" id="contact">
    <SectionHeading
      eyebrow="Contact"
      title="Get in touch"
      text="Open to master's programme applications, research collaborations and interesting engineering problems."
    />
    <div class="contact-grid">
      <a class="contact-card" href={`mailto:${profile.email}`}>
        <span class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m2 7 10 7 10-7"/>
          </svg>
        </span>
        <span class="contact-label">Email</span>
        <span class="contact-value">{profile.email}</span>
      </a>
      <a class="contact-card" href={profile.github} target="_blank" rel="noreferrer">
        <span class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </span>
        <span class="contact-label">GitHub</span>
        <span class="contact-value">felixklein84</span>
      </a>
      <a class="contact-card" href={profile.linkedin} target="_blank" rel="noreferrer">
        <span class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </span>
        <span class="contact-label">LinkedIn</span>
        <span class="contact-value">Felix Klein</span>
      </a>
      <a class="contact-card" href="https://weingut-martin-klein.de" target="_blank" rel="noreferrer">
        <span class="contact-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="10"/>
            <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
          </svg>
        </span>
        <span class="contact-label">Winery</span>
        <span class="contact-value">weingut-martin-klein.de</span>
      </a>
    </div>
  </section>
</BaseLayout>
