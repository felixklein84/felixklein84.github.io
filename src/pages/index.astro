---
import BaseLayout from '../layouts/BaseLayout.astro';
import MicArray from '../components/MicArray.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Entries from '../components/Entries.astro';
import { featuredProjects, otherProjects } from '../data/projects';
import { profile, now, experience, education, reading, offline } from '../data/cv';
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-name">
    <h1 class="hero-name" id="hero-name">Felix Klein</h1>
    <div class="hero-grid">
      <div class="hero-text">
        <p class="hero-lead">
          I study <strong>Robotics, Cognition &amp; Intelligence at TUM</strong>, coming from mathematics. I work on
          machines that have to make sense of the real world: autonomous tractors sharing a field, a microcontroller
          that hears where a siren is, and a robot that should find leaks in a factory.
        </p>
        <p>
          My tools are stochastic models, simulation and code that runs on actual hardware. Before robotics I worked
          on data and automation at BMW, KPMG and Deutsche Aircraft, and I still run the digital side of my family’s
          winery.
        </p>
        <div class="actions">
          <a class="btn primary" href="/projects">See my work</a>
          <a class="btn" href="/cv">Read my CV</a>
          <a class="btn" href={`mailto:${profile.email}`}>Email me</a>
        </div>
      </div>
      <ul class="hero-facts">
          <li><span>Studying</span><span>M.Sc. Robotics, Cognition &amp; Intelligence, TUM</span></li>
          <li><span>Research</span><span>Multi-agent routing for field robots, TUM Agricultural Mechatronics</span></li>
          <li><span>Background</span><span>B.Sc. Business Mathematics, Mannheim; exchange in Sydney</span></li>
          <li><span>Based in</span><span>Munich, open to research stays abroad</span></li>
      </ul>
      <MicArray />
    </div>
  </section>

  <section class="sec" aria-labelledby="now">
    <header>
      <h2 id="now">Now</h2>
      <p>As of {now.asOf}</p>
    </header>
    <div class="sec-body">
      <ul class="now-list">
        {
          now.items.map((n) => (
            <li>
              {n.href ? (
                <a class="now-what" href={n.href}>
                  {n.what}
                </a>
              ) : (
                <span class="now-what">{n.what}</span>
              )}
              <span class="now-detail">{n.detail}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="work">
    <header>
      <h2 id="work">Selected work</h2>
      <p>Each project links to a write-up of the problem, the approach and what came out of it.</p>
    </header>
    <div class="sec-body">
      <div class="work">
        {
          featuredProjects.map((p) => (
            <article class="work-item">
              {p.media && (
                <div class="work-media">
                  <ProjectMedia media={p.media} />
                </div>
              )}
              <div>
                <p class="work-meta">
                  <span>{p.domain}</span>
                  <span>{p.year}</span>
                </p>
                <h3>
                  <a href={`/projects/${p.slug}`}>{p.title}</a>
                </h3>
                <p>{p.summary}</p>
                <a class="sans small" href={`/projects/${p.slug}`} aria-label={`Read more: ${p.title}`}>
                  Read the write-up
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <h3 class="more-heading">More projects</h3>
      <ul class="rows">
        {
          otherProjects.map((p) => (
            <li>
              <a href={`/projects/${p.slug}`}>
                <span class="rows-title">{p.title}</span>
                <span class="rows-domain">{p.domain}</span>
                <span class="rows-year">{p.year}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="help">
    <header>
      <h2 id="help">Working together</h2>
    </header>
    <div class="sec-body">
      <div class="paths">
        <div>
          <h3>Robotics and AI teams</h3>
          <p>
            I’m looking for internships and working-student roles in startups building robots that leave the lab:
            perception, planning, simulation. I bring mathematics, fast prototyping (2nd place at the ChefTreff
            hackathon 2024) and industry experience from BMW, KPMG and Deutsche Aircraft.
          </p>
          <a href="/cv">CV and experience</a>
        </div>
        <div>
          <h3>Research groups abroad</h3>
          <p>
            I’m planning an exchange semester and a research internship abroad as part of my master’s. My interests:
            multi-robot coordination, acoustic and embedded perception, and stochastic models of systems under
            uncertainty.
          </p>
          <a href="/projects">Research projects</a>
        </div>
        <div>
          <h3>Small businesses and wineries</h3>
          <p>
            Next to my studies I take on a few projects building websites, shops and automations for small
            businesses, especially wineries. I know the trade from the inside.
          </p>
          <a href="/services" hreflang="de">Angebot auf Deutsch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="experience">
    <header>
      <h2 id="experience">Experience</h2>
    </header>
    <div class="sec-body">
      <Entries entries={experience} />
    </div>
  </section>

  <section class="sec" aria-labelledby="education">
    <header>
      <h2 id="education">Education</h2>
    </header>
    <div class="sec-body">
      <Entries entries={education} />
    </div>
  </section>

  <section class="sec" aria-labelledby="offline">
    <header>
      <h2 id="offline">Off the clock</h2>
    </header>
    <div class="sec-body">
      <div class="offline">
        <div>
          <p class="label">Reading now</p>
          <p class="book-now">{reading.now.title}</p>
          <p class="muted">{reading.now.author}</p>
          <p class="label" style="margin-top: 24px">Books I keep coming back to</p>
          <ul class="books">
            {
              reading.favourites.map((b) => (
                <li>
                  <i>{b.title}</i> <span class="muted">by {b.author}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <ul>
          {offline.map((o) => <li>{o}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" id="contact" aria-labelledby="contact-h">
    <header>
      <h2 id="contact-h">Contact</h2>
    </header>
    <div class="sec-body">
      <p>The fastest way to reach me is email. I answer in English or German.</p>
      <a class="contact-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="contact-links">
        <a href={profile.github} rel="me">GitHub</a>
        <a href={profile.linkedin} rel="me">LinkedIn</a>
        <a href="/cv">CV</a>
      </div>
    </div>
  </section>
</BaseLayout>
