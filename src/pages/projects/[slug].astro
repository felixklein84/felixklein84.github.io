---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}
const { project: p, prev, next } = Astro.props;
---

<BaseLayout title={`${p.title} · Felix Klein`} description={p.summary}>
  <article>
    <header class="page-head">
      <a class="back" href="/projects">All work</a>
      <h1>{p.title}</h1>
      <p class="lead">{p.summary}</p>
    </header>

    <dl class="facts">
      <div><dt>Field</dt><dd>{p.domain}</dd></div>
      <div><dt>When</dt><dd>{p.year}</dd></div>
      <div><dt>Context</dt><dd>{p.role}</dd></div>
      <div><dt>Status</dt><dd>{p.status}</dd></div>
    </dl>

    {
      p.media && (
        <figure class="case-media">
          <div>
            <ProjectMedia media={p.media} eager />
          </div>
          {p.media.caption && <figcaption>{p.media.caption}</figcaption>}
        </figure>
      )
    }

    <div class="case-body">
      <h2>The problem</h2>
      <p>{p.problem}</p>

      <h2>{p.slug === 'compressed-air-leak-detection' ? 'Planned approach' : 'Approach'}</h2>
      <ul>
        {p.approach.map((a) => <li>{a}</li>)}
      </ul>

      <h2>{p.slug === 'compressed-air-leak-detection' ? 'Where it stands' : 'Result'}</h2>
      <ul>
        {p.outcome.map((o) => <li>{o}</li>)}
      </ul>

      <h2>Tools</h2>
      <ul class="tags">
        {p.stack.map((s) => <li>{s}</li>)}
      </ul>

      {
        p.links.length > 0 ? (
          <div class="actions">
            {p.links.map((l, i) => (
              <a class={i === 0 ? 'btn primary' : 'btn'} href={l.href}>
                {l.label}
              </a>
            ))}
          </div>
        ) : (
          <p class="muted small sans" style="margin-top: 28px">
            The code belongs to my employer or chair and isn’t public. I’m happy to walk through it in a conversation.
          </p>
        )
      }
    </div>

    <nav class="pager" aria-label="More work">
      {
        prev ? (
          <a href={`/projects/${prev.slug}`}>
            <span>Previous</span>
            {prev.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/projects/${next.slug}`} style="text-align: right">
            <span>Next</span>
            {next.title}
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
