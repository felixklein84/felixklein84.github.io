---
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '../styles/global.css';
import { profile } from '../data/cv';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'de';
  image?: string;
}

const {
  title = 'Felix Klein · Robotics, mathematics, real systems',
  description = 'Felix Klein studies Robotics, Cognition & Intelligence at TUM. Mathematics background, research on autonomous field robots, embedded acoustic perception and stochastic simulation.',
  lang = 'en',
  image = '/og/felix-klein.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? profile.site).href;
const ogImage = new URL(image, Astro.site ?? profile.site).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const nav =
  lang === 'de'
    ? [
        { href: '/projects', label: 'Projekte' },
        { href: '/cv', label: 'Lebenslauf' },
        { href: '/services', label: 'Für Betriebe' },
        { href: '/#contact', label: 'Kontakt' },
      ]
    : [
        { href: '/projects', label: 'Work' },
        { href: '/cv', label: 'CV' },
        { href: '/services', label: 'Services' },
        { href: '/#contact', label: 'Contact' },
      ];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: profile.site,
  image: ogImage,
  email: `mailto:${profile.email}`,
  jobTitle: 'M.Sc. student, Robotics, Cognition & Intelligence',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Technical University of Munich' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Mannheim' },
    { '@type': 'CollegeOrUniversity', name: 'Western Sydney University' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Munich', addressCountry: 'DE' },
  knowsAbout: ['Robotics', 'Multi-agent planning', 'Acoustic localisation', 'Stochastic processes', 'Simulation', 'Machine learning'],
  sameAs: [profile.github, profile.linkedin],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3f4f0" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Felix Klein, M.Sc. Robotics, Cognition & Intelligence, TUM Munich" />
    <meta property="og:site_name" content="Felix Klein" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'de' ? 'Zum Inhalt' : 'Skip to content'}</a>
    <div class="wrap">
      <header class="nav">
        <a class="nav-home" href="/">Felix Klein</a>
        <nav class="nav-links" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main'}>
          {nav.map((l) => (
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <span>© {new Date().getFullYear()} Felix Klein, Munich</span>
        <nav aria-label="Elsewhere">
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={profile.github} rel="me">GitHub</a>
          <a href={profile.linkedin} rel="me">LinkedIn</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
